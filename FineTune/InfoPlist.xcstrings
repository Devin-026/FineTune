{
  "sourceLanguage": "en",
  "strings": {
    "NSAudioCaptureUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FineTune needs access to control volume levels for individual applications."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "FineTune 需要采集系统音频，才能分别控制各个应用的音量。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FineTune needs microphone access to capture audio from apps using input-capable devices."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "FineTune 需要麦克风权限，才能采集使用带输入功能的设备的应用音频。"
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FineTune uses Bluetooth to connect paired audio devices from the menu bar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "FineTune 使用蓝牙，以便从菜单栏连接已配对的音频设备。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
